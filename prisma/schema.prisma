generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model EmailList {
  id           String   @id @default(uuid())
  email        String
  name         String
  linkedinId   String?
  pageAccessed String?
  createdAt    DateTime @default(now())

  @@index([email, pageAccessed])
}

model Admin {
  id       String @id @default(uuid())
  email    String @unique
  password String
}